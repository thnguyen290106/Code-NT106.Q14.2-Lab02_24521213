        private double Calculate(string s)
        {
            List<double> numbers = new List<double>();
            List<char> operators = new List<char>();
            string StringNumber = "";
            if (s[0] == '-' || s[0] == '+') StringNumber += s[0];
            for (int i = 0; i < s.Length; ++i)
            {
                if (s[i] >= '0' && s[i] <= '9' || s[i] == '.') StringNumber += s[i];
                if (s[i] == '+' || s[i] == '-' || s[i] == '*' || s[i] == '/')
                {
                    numbers.Add(double.Parse(StringNumber));
                    StringNumber = "";
                    operators.Add(s[i]);
                }
            }
            double result = 0.0;
            for (int i = 0; i < operators.Count; ++i)
            {
                if (operators[i] == '+') result += numbers[i] + numbers[i + 1];
                else if (operators[i] == '-') result += numbers[i] - numbers[i + 1];
                else if (operators[i] == '*') result += numbers[i] * numbers[i + 1];
                else result += numbers[i] / numbers[i + 1];
            }
            return result;
        }

        private void btnRead_Click(object sender, EventArgs e)
        {
            try
            {
                // Đọc tất cả các dòng từ file input3.txt
                string[] lines = File.ReadAllLines("input3.txt");
                List<string> outputLines = new List<string>();

                foreach (string line in lines)
                {
                    // Bỏ qua dòng trống
                    if (string.IsNullOrWhiteSpace(line)) continue;
                    
                    try
                    {
                        // Tính toán kết quả sử dụng hàm Calculate
                        double result = Calculate(line.Trim());
                        // Tạo chuỗi kết quả theo định dạng yêu cầu
                        string outputLine = $"{line} = {result}";
                        outputLines.Add(outputLine);
                    }
                    catch (Exception ex)
                    {
                        // Nếu có lỗi khi tính toán một dòng, ghi lại lỗi
                        outputLines.Add($"{line} = Error: {ex.Message}");
                    }
                }

                // Ghi tất cả kết quả vào file output3.txt
                File.WriteAllLines("output3.txt", outputLines);
                MessageBox.Show("Đã xử lý và ghi kết quả vào file output3.txt thành công!", "Thông báo");
            }
            catch (FileNotFoundException)
            {
                MessageBox.Show("Không tìm thấy file input3.txt!", "Lỗi");
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Đã xảy ra lỗi: {ex.Message}", "Lỗi");
            }
        }
    }
